{
  "name": "finite-state-machine",
  "description": "finite state machine",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc && vite build",
    "build-storybook": "storybook build",
    "dev": "vite",
    "lint": "eslint src --ext ts,tsx,json --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --fix --ext ts,tsx,json --report-unused-disable-directives --max-warnings 0",
    "lint:staged": "npx lint-staged",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "test:ui": "vitest --ui --coverage.enabled=true"
  },
  "engines": {
    "node": "20.x",
    "yarn": "1.22.x"
  },
  "lint-staged": {
    "**/*.{ts,tsx,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
